---
import { orderedQuestions, questionHref } from '@/lib/learningPath';

interface Props { hideWhenEmpty?: boolean }
const { hideWhenEmpty = false } = Astro.props;
// [id, href, title] を学習パス順に並べる。未正解の最初の1問が「続きから」の行き先になる。
const path = orderedQuestions.map((question) => [question.id, questionHref(question), question.title]);
---
<progress-summary class="block" data-hide-when-empty={String(hideWhenEmpty)} {...(hideWhenEmpty ? { hidden: '' } : {})}>
  <script is:inline type="application/json" data-path set:html={JSON.stringify(path).replace(/</g, '\\u003c')} />
  <div class="rounded-xl border border-line p-5">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <p class="text-sm text-muted"><span data-solved class="font-mono text-lg text-ink">0</span> / {path.length}問 正解</p>
      <p data-streak class="text-sm text-muted" hidden></p>
    </div>
    <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-line" role="progressbar" aria-label="正解した問題数" aria-valuemin="0" aria-valuemax={path.length} aria-valuenow="0">
      <div data-bar class="h-full rounded-full bg-brand" style="width:0%"></div>
    </div>
    <p class="mt-4"><a data-resume class="btn btn-sm focus-ring" href={path[0][1]}>最初の問題から始める →</a></p>
  </div>
</progress-summary>

<script>
  import { PROGRESS_EVENT, currentStreak, loadProgress } from '@/lib/progress';

  class ProgressSummaryElement extends HTMLElement {
    private path: [string, string, string][] = [];
    private render = () => {
      const state = loadProgress();
      const solvedIds = new Set(state.solvedIds);
      const solved = this.path.filter(([id]) => solvedIds.has(id)).length;
      this.hidden = this.dataset.hideWhenEmpty === 'true' && solved === 0;

      const count = this.querySelector<HTMLElement>('[data-solved]');
      if (count) count.textContent = String(solved);
      const bar = this.querySelector<HTMLElement>('[data-bar]');
      if (bar) bar.style.width = `${this.path.length ? (solved / this.path.length) * 100 : 0}%`;
      this.querySelector('[role="progressbar"]')?.setAttribute('aria-valuenow', String(solved));

      const streak = currentStreak(state);
      const streakLabel = this.querySelector<HTMLElement>('[data-streak]');
      if (streakLabel) {
        streakLabel.hidden = streak < 2;
        streakLabel.textContent = `${streak}日連続で正解中`;
      }

      const resume = this.querySelector<HTMLAnchorElement>('[data-resume]');
      if (!resume) return;
      const next = this.path.find(([id]) => !solvedIds.has(id));
      if (!next) {
        resume.href = '/practice/';
        resume.textContent = 'すべて正解済み。演習一覧を見る →';
      } else {
        resume.href = next[1];
        resume.textContent = solved === 0 ? '最初の問題から始める →' : `続きから：${next[2]} →`;
      }
    };

    connectedCallback() {
      try {
        this.path = JSON.parse(this.querySelector('[data-path]')?.textContent ?? '[]');
      } catch {
        this.path = [];
      }
      this.render();
      window.addEventListener('pageshow', this.render);
      window.addEventListener('storage', this.render);
      window.addEventListener(PROGRESS_EVENT, this.render);
    }

    disconnectedCallback() {
      window.removeEventListener('pageshow', this.render);
      window.removeEventListener('storage', this.render);
      window.removeEventListener(PROGRESS_EVENT, this.render);
    }
  }
  if (!customElements.get('progress-summary')) customElements.define('progress-summary', ProgressSummaryElement);
</script>
