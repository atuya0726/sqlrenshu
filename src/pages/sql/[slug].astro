---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SqlPlayground from '@/components/SqlPlayground.astro';
import AdSlot from '@/components/AdSlot.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import GuideTable from '@/components/GuideTable.astro';
import SqlTerms from '@/components/SqlTerms.astro';
import { sqlTopics, sqlTopicBySlug } from '@/data/sqlTopics';
import { getQuestionsByCategory } from '@/questions/catalog';

export function getStaticPaths() { return sqlTopics.map((topic) => ({ params:{ slug:topic.slug } })); }
const topic = sqlTopicBySlug[Astro.params.slug!];
const mainExercise = topic.practiceCategory ? getQuestionsByCategory(topic.practiceCategory)[0] : undefined;
const jsonLd = [
  { '@context':'https://schema.org','@type':'TechArticle',headline:topic.title,description:topic.description,inLanguage:'ja',mainEntityOfPage:new URL(Astro.url.pathname, Astro.site),citation:topic.references.map((reference) => reference.url) },
  { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
    {'@type':'ListItem',position:1,name:'ホーム',item:new URL('/', Astro.site)},
    {'@type':'ListItem',position:2,name:'SQLガイド',item:new URL('/sql/', Astro.site)},
    {'@type':'ListItem',position:3,name:topic.label,item:new URL(Astro.url.pathname, Astro.site)},
  ]},
  { '@context':'https://schema.org','@type':'FAQPage',mainEntity:topic.faqs.map((faq) => ({'@type':'Question',name:faq.question,acceptedAnswer:{'@type':'Answer',text:faq.answer}})) },
];
---
<BaseLayout title={`${topic.title}｜SQL練習室`} description={topic.description} jsonLd={jsonLd}>
  <article>
    <header class="container-shell py-14">
      <a class="link text-sm" href="/sql/">← SQLガイド</a>
      <h1 class="mt-4 text-3xl">{topic.title}</h1>
      <p class="mt-4 max-w-xl text-lg leading-8 text-muted">{topic.lead}</p>
    </header>
    <div class="container-shell border-t border-line py-12">
      <div class="prose-sql">
        <nav class="not-prose rounded-xl border border-line bg-neutral-50 p-5" aria-label="このページの目次">
          <p class="font-medium">このページでわかること</p>
          <ul class="mt-3 grid gap-2 text-sm text-muted sm:grid-cols-2">
            {topic.sampleTables && <li><a class="link" href="#sample-tables">例で使う表</a></li>}
            <li><a class="link" href="#syntax">{topic.label}の基本構文</a></li>
            {topic.sections.map((section, index) => <li><a class="link" href={`#section-${index + 1}`}>{section.heading}</a></li>)}
            {topic.notes.length > 0 && <li><a class="link" href="#tips">知っていると便利なTips</a></li>}
            {topic.mistakes.length > 0 && <li><a class="link" href="#mistakes">よくある間違い</a></li>}
          </ul>
        </nav>
        {topic.sampleTables && <><h2 id="sample-tables">例で使う表</h2><p>{topic.sampleIntro}</p>{topic.sampleTables.map((table) => <GuideTable table={table} caption={table.caption} />)}</>}
        <h2 id="syntax">{topic.label}の基本構文</h2><div class="not-prose mt-4"><CodeBlock code={topic.syntax} /></div>
        {topic.sections.map((section, index) => <><h2 id={`section-${index + 1}`}>{section.heading}</h2><p><SqlTerms text={section.body} /></p>
          {section.table && <div class="not-prose mt-5 overflow-x-auto rounded-xl border border-line">
            <table class="w-full border-collapse text-sm">
              <thead><tr class="bg-neutral-50">{section.table.headers.map((header) => <th class="border-b border-line px-4 py-2.5 text-left font-medium text-muted">{header}</th>)}</tr></thead>
              <tbody>{section.table.rows.map((row) => <tr class="divide-x divide-line">{row.map((cell, cellIndex) => <td class={`border-b border-line px-4 py-2.5 ${cellIndex === row.length - 1 ? 'font-mono text-xs' : ''}`}>{cell}</td>)}</tr>)}</tbody>
            </table>
          </div>}
          <div class="not-prose mt-5"><CodeBlock code={section.code} /></div>
          {section.resultTable && <GuideTable table={section.resultTable} caption="実行結果" />}
        </>)}
        {topic.notes.map((note, index) => <aside id={index === 0 ? 'tips' : undefined} class="not-prose mt-8 border-l-4 border-brand py-1 pl-5">
          <p class="flex items-center gap-2 font-mono text-sm font-semibold text-brand">
            <span class="inline-flex size-5 items-center justify-center rounded-full border border-current text-xs" aria-hidden="true">i</span>
            Tips — {note.title}
          </p>
          <p class="mt-2 leading-7 text-muted"><SqlTerms text={note.body} /></p>
          {note.code && <div class="mt-4"><CodeBlock code={note.code} /></div>}
        </aside>)}
        {topic.mistakes.length > 0 && <><h2 id="mistakes">{topic.label}でよくある間違い</h2>
          <div class="not-prose space-y-5">{topic.mistakes.map((mistake) => <div class="rounded-xl border border-line p-5">
            <p class="font-medium">{mistake.title}</p>
            <p class="mt-2 text-sm leading-7 text-muted"><SqlTerms text={mistake.body} /></p>
            {mistake.code && <div class="mt-4"><CodeBlock code={mistake.code} /></div>}
          </div>)}</div>
        </>}
        <AdSlot placement={`sql-${topic.slug}-middle`} />
        {topic.practiceCategory && mainExercise && <>
          <h2>実際に1問解いてみる</h2>
          <div class="not-prose mt-6"><SqlPlayground question={mainExercise} compact /></div>
          <div class="not-prose my-14 text-center">
            <a class="btn focus-ring px-8 py-4 text-base" href={`/practice/${topic.practiceCategory}/`}>{topic.label}の本格演習へ →</a>
          </div>
        </>}
        <h2>関連構文</h2><div class="not-prose mt-3 flex flex-wrap gap-2">{topic.related.map((slug) => <a class="chip focus-ring" href={`/sql/${slug}/`}>{sqlTopicBySlug[slug]?.label ?? slug}</a>)}</div>
        <h2>{topic.label}についてよくある質問</h2>
        <dl class="not-prose mt-4 divide-y divide-line border-y border-line">
          {topic.faqs.map((faq) => <div class="py-5"><dt class="font-medium">{faq.question}</dt><dd class="mt-2 text-sm leading-7 text-muted">{faq.answer}</dd></div>)}
        </dl>
        <h2>参考文献</h2>
        <p>内容はPostgreSQL公式ドキュメントを参照し、初めて学ぶ人向けに日本語で整理しています。</p>
        <ul>{topic.references.map((reference) => <li><a class="link" href={reference.url} rel="noreferrer">{reference.label}</a> — {reference.description}</li>)}</ul>
        <aside class="not-prose mt-12 border-t border-line pt-8 text-sm">
          <p class="font-medium">このページの役割</p>
          <p class="mt-2 leading-7 text-muted">{topic.label}の構文と考え方を理解するための解説ページです。{topic.practiceCategory ? '知識を定着させる反復練習は、演習ページに分けています。' : '関連する構文もあわせて読むと、SELECT文全体の組み立て方を理解しやすくなります。'}</p>
          {topic.practiceCategory && <a class="link mt-3 inline-block" href={`/practice/${topic.practiceCategory}/`}>{topic.label}の集中演習へ →</a>}
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
