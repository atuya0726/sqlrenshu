---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SqlPlayground from '@/components/SqlPlayground.astro';
import AdSlot from '@/components/AdSlot.astro';
import { questions } from '@/questions/catalog';
import { categoryLabels, guideHrefForCategory } from '@/lib/categories';
import { nextStep, previousInCategory } from '@/lib/learningPath';

export function getStaticPaths() {
  return questions.map((question) => ({ params:{ category:question.category, id:question.id }, props:{ question } }));
}
const { question } = Astro.props;
const categoryQuestions = questions.filter((item) => item.category === question.category);
const index = categoryQuestions.findIndex((item) => item.id === question.id);
// カテゴリ最後の問題では、次のカテゴリの1問目へ進める。
const { href: nextHref, label: nextLabel } = nextStep(question);
const previous = previousInCategory(question);
const guideHref = guideHrefForCategory(question.category);
const label = categoryLabels[question.category] ?? question.category;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
// 同名の問題が別カテゴリにもあるため、titleにはカテゴリ名と問題番号を含めて一意にする。
const title = `${question.title}｜${label}のSQL練習問題${index + 1}`;
const description = `${question.description} ブラウザ内のPostgreSQLで実行・自動採点できる${label}の練習問題です。登録不要、ヒントと解答例つき。`;
const jsonLd = [
  { '@context':'https://schema.org','@type':'LearningResource',name:title,description:question.description,inLanguage:'ja',url:pageUrl,learningResourceType:'練習問題',teaches:`SQL ${label}`,isAccessibleForFree:true,educationalLevel:`レベル${question.level}` },
  { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
    {'@type':'ListItem',position:1,name:'ホーム',item:new URL('/', Astro.site)},
    {'@type':'ListItem',position:2,name:'SQL演習',item:new URL('/practice/', Astro.site)},
    {'@type':'ListItem',position:3,name:label,item:new URL(`/practice/${question.category}/`, Astro.site)},
    {'@type':'ListItem',position:4,name:question.title,item:pageUrl},
  ]},
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <header class="workspace-shell flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pt-6">
    <a class="link focus-ring text-sm" href={`/practice/${question.category}/`}>← {label}の練習問題一覧</a>
    <p class="flex items-baseline gap-4 font-mono text-xs text-muted">
      <span>{index + 1} / {categoryQuestions.length}</span>
      <span title="難易度（1〜5）">Lv.{question.level}</span>
      {previous && <a class="link focus-ring font-sans" href={previous.href} title={previous.label}>← 前の問題</a>}
    </p>
  </header>
  <section class="workspace-shell py-8"><SqlPlayground question={question} nextHref={nextHref} nextLabel={nextLabel} guideHref={guideHref} /><AdSlot placement="practice-after-explanation" /></section>
</BaseLayout>
