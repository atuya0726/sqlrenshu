{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sqlrenshu",
  "compatibility_date": "2026-09-04",
  // 配信は独自ドメイン（sqlrenshu.com）だけにする。workers.dev は同じ内容の重複になるため止める。
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
